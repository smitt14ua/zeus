# Enforce LF line endings for all text files in the repo.
# Overrides core.autocrlf on Windows so git never silently rewrites files.
* text=auto eol=lf

# Explicitly mark binary files so git never attempts CRLF conversion.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pbo  binary
*.exe  binary
